<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FS France Libre</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: Helvetica, Arial, sans-serif; background: #fff; color: #222; padding: 0; }
  #wrap { max-width: 100%; margin: 0 auto; }

  .card { border: 1px solid #ddd; background: #fff; }
  .photo { width: 100%; aspect-ratio: 16 / 9; background: #d9d9d9; display: flex; align-items: center; justify-content: center; color: #888; font-size: 13px; overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .caption { font-size: 11px; font-style: italic; color: #777; padding: 8px 14px; background: #f7f6f2; }
  .caption b { font-weight: 700; }

  .head { background: #36332f; padding: 14px 16px 12px; border-bottom: 3px solid #c8441f; }
  .kicker { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: #aaa; margin-bottom: 4px; }
  .name { font-size: 20px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: #fff; }
  .type { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #e0562e; margin-top: 4px; font-weight: 700; }

  table { width: 100%; border-collapse: collapse; }
  tr:nth-child(odd)  { background: #fff; }
  tr:nth-child(even) { background: #f7f6f2; }
  th, td { text-align: left; vertical-align: top; padding: 11px 16px; font-size: 14px; border-bottom: 1px solid #eee; }
  th { width: 34%; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #8a867e; font-weight: 700; }
  td { font-weight: 700; line-height: 1.4; }

  .source { font-size: 11px; font-style: italic; color: #777; padding: 8px 14px; }
  .source b { font-weight: 700; }
</style>
</head>
<body>
<div id="wrap"><div id="card-host"></div></div>

<script>
/* ═══════════════════════════════════════════════════════
   EDIT THE SHIP DATA HERE
   - Rows with an empty value are not shown.
   - photo: URL of the photo alone. Leave "" for a grey box.
   - type and caption are blank because none were provided.
   ═══════════════════════════════════════════════════════ */
const SHIP = {
  name: "FS France Libre",
  type: "",
  photo: "https://news.usni.org/wp-content/uploads/2026/11/France-Libre-aircraft-carrier-PANG-3-1024x576.jpg.jpeg",
  caption: "",
  sourceLabel: "Source",
  source: "Naval Group, French Navy",
  specs: [
    ["Builder", "MO Porte-Avions (Naval Group / Chantiers de l'Atlantique); reactors by TechnicAtome"],
    ["Length", "1,017 feet"],
    ["Width", "295 feet"],
    ["Maximum speed", "27 knots"],
    ["Full load displacement", "80,000 tons"],
    ["Flight deck area", "About 183,000 square feet"],
    ["Crew", "2,000 persons on board"],
    ["Service life", "Approx. 45 years"],
    ["Propulsion", "Two K22 nuclear reactors"],
    ["Catapults", "Electromagnetic Aircraft Launch System (EMALS)"],
    ["Air wing", "About 30 Dassault Rafale M F5 combat aircraft, three Northrop Grumman E-2D Hawkeye airborne early warning aircraft and up to six NH90 Caïman helicopters"],
    ["Delivery", "2038"]
  ]
};

const KICKER = "Vessel Profile";

/* ── Rendering (no need to edit below) ── */
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const rows = SHIP.specs.filter(([, v]) => v).map(([k, v]) => `<tr><th>${esc(k)}</th><td>${esc(v)}</td></tr>`).join('');

document.getElementById('card-host').innerHTML = `
  <div class="card">
    <div class="photo">${SHIP.photo ? `<img src="${esc(SHIP.photo)}" alt="${esc(SHIP.name)}">` : 'Photo goes here'}</div>
    ${SHIP.caption ? `<div class="caption"><b>Photo:</b> ${esc(SHIP.caption)}</div>` : ''}
    <div class="head">
      <div class="kicker">${esc(KICKER)}</div>
      <div class="name">${esc(SHIP.name)}</div>
      ${SHIP.type ? `<div class="type">${esc(SHIP.type)}</div>` : ''}
    </div>
    <table>${rows}</table>
    ${SHIP.source ? `<div class="source"><b>${esc(SHIP.sourceLabel)}:</b> ${esc(SHIP.source)}</div>` : ''}
  </div>`;

/* Tell the WordPress page how tall this embed is, so the iframe fits exactly */
const wrapEl = document.getElementById('wrap');
function postHeight() {
  parent.postMessage({ type: 'vessel-card-height', height: wrapEl.offsetHeight + 4 }, '*');
}
new ResizeObserver(postHeight).observe(wrapEl);
window.addEventListener('load', postHeight);
</script>
</body>
</html>
